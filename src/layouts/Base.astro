---
import "../styles/global.css";
const {
  title,
  description,
  type = "website",
  pubDate,
  author = "Deniz Yanbollu",
  image,
  lang = "en",
} = Astro.props;

// Canonicalize to the no-trailing-slash form (what the main site, sitemap, and
// cross-post canonicals all link to), so /blog/x and /blog/x/ do not split.
// Exception: the blog index is served at /blog/ (the base root) and /blog
// 301-redirects to it, so keep the trailing slash there or the canonical would
// point at a redirect.
const stripped = Astro.url.pathname.replace(/(.+)\/$/, "$1");
const canonical = new URL(stripped === "/blog" ? "/blog/" : stripped, Astro.site).href;
// Per-post OG image when set in frontmatter, else the site default card.
const ogImage = image || "https://shieldz.cash/assets/brand/og-card.png";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const articleLd =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        datePublished: pubDate ? new Date(pubDate).toISOString() : undefined,
        author: { "@type": "Person", name: author },
        publisher: { "@type": "Organization", name: "Shieldz", url: "https://shieldz.cash" },
        mainEntityOfPage: canonical,
        image: ogImage,
      }
    : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Shieldz" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@shieldzcash" />
    <meta name="twitter:creator" content="@dnzynbl" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" href="https://shieldz.cash/assets/brand/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1PV99TH7BG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1PV99TH7BG');
    </script>
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a class="brand" href={base}>
          <img src="https://shieldz.cash/assets/brand/logo-sz-white.png?v=2" alt="" aria-hidden="true" />
          shield<span class="z">z</span> blog
        </a>
        <nav>
          <a href="https://shieldz.cash/">Home</a>
          <a href="https://shieldz.cash/agents">Agents</a>
          <a href="https://shieldz.cash/docs">Docs</a>
        </nav>
      </header>
      <slot />
      <footer class="site">
        <p>
          <a href="https://shieldz.cash/">Shieldz</a> is non-custodial crypto payments with $0 platform fees.
          <a href="https://shieldz.cash/introducing-shieldz">Learn more</a> &middot;
          <a href="https://discord.gg/8AmvrMmvMp">Discord</a> &middot;
          <a href={base + "/rss.xml"}>RSS</a>
        </p>
      </footer>
    </div>
    <!-- Simple Analytics via the same first-party proxy the landing uses
         (/proxy.js and /simple/* are served by the apex backend, same origin). -->
    <script is:inline data-collect-dnt="true" async src="/proxy.js"></script>
    <noscript><img src="/simple/noscript.gif?collect-dnt=true" alt="" referrerpolicy="no-referrer-when-downgrade" /></noscript>
  </body>
</html>
