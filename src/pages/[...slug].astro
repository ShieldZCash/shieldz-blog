---
import Base from "../layouts/Base.astro";
import SwapBanner from "../components/SwapBanner.astro";
import { getCollection, render } from "astro:content";
import { readFileSync } from "node:fs";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Every post gets an auto-generated OG card at /blog/og/<slug>.png (built by
// scripts/gen-og.mjs in the prebuild step). Frontmatter `ogImage` can override.
const ogImage = post.data.ogImage ?? new URL(`/blog/og/${post.id}.png`, Astro.site).href;

// Schema.org Dataset markup for the post that is a dataset's canonical home,
// built from the same JSON served at /blog/data/<name>.json.
let datasetLd;
if (post.data.dataset) {
  const name = post.data.dataset;
  const d = JSON.parse(readFileSync(`public/data/${name}.json`, "utf8"));
  const dataUrl = (ext) => new URL(`/blog/data/${name}.${ext}`, Astro.site).href;
  datasetLd = {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: d.dataset,
    description: `${d.methodology} ${d.counts.total} gateways as of ${d.updated}.`,
    url: d.canonical,
    sameAs: "https://github.com/ShieldZCash/crypto-payment-gateways-dataset",
    version: d.version,
    datePublished: d.published,
    dateModified: d.updated,
    license: d.license_url,
    isAccessibleForFree: true,
    creator: { "@type": "Organization", name: d.publisher, url: d.publisher_url },
    keywords: post.data.tags,
    variableMeasured: Object.keys(d.field_dictionary),
    distribution: [
      { "@type": "DataDownload", encodingFormat: "application/json", contentUrl: dataUrl("json") },
      { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: dataUrl("csv") },
    ],
  };
}

// FAQPage markup from the post's own "## FAQ" section. Questions are bold
// lines ("**Q?**" on its own line, or "**Q?** answer" inline); the answer runs
// to the next question. Posts that already embed their own FAQPage are skipped.
const plain = (md) =>
  md
    .replace(/<[^>]+>/g, "")
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[*_`]/g, "")
    .replace(/\s+/g, " ")
    .trim();
let faqLd;
const body = post.body ?? "";
if (!body.includes('"FAQPage"')) {
  const m = body.match(/^## (?:FAQ|Frequently asked questions|Frequently Asked Questions)[^\n]*\n([\s\S]*?)(?=^## |(?![\s\S]))/m);
  if (m) {
    const items = [];
    for (const block of m[1].split(/\n(?=\*\*[^*\n]+\*\*)/)) {
      const q = block.match(/^\*\*([^*\n]+)\*\*\s*([\s\S]*)$/);
      if (!q) continue;
      const answer = plain(q[2]);
      if (q[1].trim().endsWith("?") && answer) items.push({ q: plain(q[1]), a: answer });
    }
    if (items.length >= 2) {
      faqLd = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: items.map(({ q, a }) => ({
          "@type": "Question",
          name: q,
          acceptedAnswer: { "@type": "Answer", text: a },
        })),
      };
    }
  }
}

const crumbsLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Shieldz", item: "https://shieldz.cash/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://shieldz.cash/blog/" },
    { "@type": "ListItem", position: 3, name: post.data.title, item: `https://shieldz.cash/blog/${post.id}` },
  ],
};
---

<Base
  title={`${post.data.title} | Shieldz Blog`}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  author={post.data.author}
  image={ogImage}
  lang={post.data.lang}
  datasetLd={datasetLd}
  extraLd={[faqLd, crumbsLd].filter(Boolean)}
>
  <article>
    <h1>{post.data.title}</h1>
    <p class="meta">
      {post.data.author} &middot;
      {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
    </p>
    {post.data.swapBanner && <SwapBanner slug={post.id} />}
    <Content />
  </article>
</Base>
